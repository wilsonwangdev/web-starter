{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "browser": false,
    "node": true
  },
  "plugins": ["unicorn", "typescript", "oxc", "react", "jsx-a11y", "vitest"],
  "options": {
    "typeAware": true
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "react/only-export-components": ["error", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "src/**/*.tsx", "tests/browser/**/*.tsx"],
      "env": { "browser": true, "node": false }
    },
    {
      "files": ["tests/e2e/**/*.ts"],
      "env": { "browser": true, "node": true }
    },
    {
      "files": ["src/app/**/*.ts", "src/app/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/pages", "**/pages/**", "**/draft", "**/draft.*", "**/draft/**"],
                "caseSensitive": true,
                "message": "共享页面结构和文档元信息只依赖基础能力；页面与草稿由 App 组装。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/pages/**/*.ts", "src/pages/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/App",
                  "**/App.*",
                  "**/App/**",
                  "**/AppShell",
                  "**/AppShell.*",
                  "**/AppShell/**"
                ],
                "caseSensitive": true,
                "message": "页面通过输入和动作参与组装，不反向依赖应用入口或外壳。"
              }
            ]
          }
        ]
      }
    }
  ]
}
