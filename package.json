{
  "name": "web-starter",
  "version": "0.1.0",
  "private": true,
  "description": "可持续维护的 Web 应用起点",
  "homepage": "https://github.com/wilsonwangdev/web-starter#readme",
  "bugs": {
    "url": "https://github.com/wilsonwangdev/web-starter/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilsonwangdev/web-starter.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "assets:generate": "pwa-assets-generator",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "lint:styles": "stylelint \"src/**/*.css\" --max-warnings 0",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project \"browser-*\"",
    "test:e2e": "pnpm build && playwright test",
    "check": "pnpm lint && pnpm lint:styles && pnpm fmt:check && pnpm typecheck && pnpm test && pnpm test:e2e",
    "check:staged": "lint-staged --hide-all --concurrent false",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "i18next": "26.5.11",
    "lucide-react": "1.61.0",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-router": "8.5.0",
    "use-local-storage-state": "20.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-app-manifest": "1.0.9",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "stylelint": "17.16.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0"
  },
  "config": {
    "gitleaksImage": "ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.15.0",
  "product": {
    "displayName": "起点",
    "tagline": "把想法，变成下一步",
    "locale": "zh-CN",
    "themeColor": "#21252d",
    "storageNamespace": "web-starter"
  }
}
